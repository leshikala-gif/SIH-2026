<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Dadar_Flood_Nowcast" version="3.28.0">
  <homePath path=""/>
  <title>Dadar Urban Flood Nowcasting</title>
  <projectCrs>
    <spatialrefsys>
      <wkt>GEOGCRS["WGS 84",DATUM["World Geodetic System 1984",ELLIPSOID["WGS 84",6378137,298.257223563]],PRIMEM["Greenwich",0],UNIT["degree",0.0174532925199433]]</wkt>
      <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
      <srsid>3452</srsid>
      <srid>4326</srid>
      <authid>EPSG:4326</authid>
      <description>WGS 84</description>
    </spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <customproperties/>
    <layer-tree-layer id="pilot_roads" name="Dadar Road Network" source="./data/processed/pilot_roads.geojson" provider="ogr" checked="Qt::Checked"/>
    <layer-tree-layer id="buildings" name="Dadar Building Footprints" source="./data/raw/buildings.gpkg|layername=buildings" provider="ogr" checked="Qt::Checked"/>
    <custom-order enabled="0">
      <item>pilot_roads</item>
      <item>buildings</item>
    </custom-order>
  </layer-tree-group>
  <projectlayers>
    <maplayer type="vector" id="pilot_roads" name="Dadar Road Network">
      <id>pilot_roads</id>
      <datasource>./data/processed/pilot_roads.geojson</datasource>
      <provider>ogr</provider>
    </maplayer>
    <maplayer type="vector" id="buildings" name="Dadar Building Footprints">
      <id>buildings</id>
      <datasource>./data/raw/buildings.gpkg|layername=buildings</datasource>
      <provider>ogr</provider>
    </maplayer>
  </projectlayers>
</qgis>